# ── PET backend configuration ────────────────────────────────────────────────
# Copy to `.env` and adjust. Every value has a safe default for local dev;
# production (office PC) must set PET_JWT_SECRET and CORS_ORIGINS explicitly.

# HTTP listener. 8080 matches the documented office-PC setup.
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Comma-separated browser origins allowed to call the API (Vercel frontend,
# Cloudflare tunnel domain). Leave empty to allow any origin — dev only.
CORS_ORIGINS=https://software.plusoneco.in,https://app.plusoneco.in

# Signing key for access/refresh JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# When omitted, an ephemeral key is generated at boot (all sessions reset on restart).
PET_JWT_SECRET=

# Token lifetimes
PET_ACCESS_TTL_SECONDS=900
PET_REFRESH_TTL_DAYS=30

# Storage
PET_DB_PATH=./data/pet.db
PET_FILES_DIR=./data/files
PET_MAX_UPLOAD_BYTES=15728640

# Optional first-boot bootstrap: if the DB has no main admin and these are
# set, an account is created (must_change_password=true when a temporary
# password is given). Prefer `npm run bootstrap-admin` for explicit control.
PET_ADMIN_EMAIL=
PET_ADMIN_PASSWORD=

# Login attempts per IP per minute (0 disables the limiter).
PET_AUTH_RATE_LIMIT=30

# ── Response compression (Brotli + Zstd, node:zlib — no extra deps) ─────────
# Compress API JSON and SPA assets at least this many bytes (0 = off).
PET_COMPRESS_MIN_BYTES=1024
# Brotli quality 0–11 (6 ≈ good ratio at server-friendly encode cost).
PET_BROTLI_QUALITY=6
# Zstd level 0–22; leave empty for zlib's default.
PET_ZSTD_LEVEL=

# Set to 1 when running behind a reverse proxy / Cloudflare Tunnel.
PET_TRUST_PROXY=1
